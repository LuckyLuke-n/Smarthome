{
  "$schema": "http://json.schemastore.org/launchsettings.json",
  "profiles": {
    "Smarthome.AmbientCollector.Api": {
      "commandName": "Project",
      "launchBrowser": false,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "SMARTHOME_Api__LogLevel": "3",
        "SMARTHOME_Api__Key": "secret",
        "SMARTHOME_MongoDb__ConnectionString": "mongodb://localhost:27017",
        "SMARTHOME_Mqtt__Host": "localhost",
        "SMARTHOME_Mqtt__Port": "1883",
        "SMARTHOME_Mqtt__Username": "admin",
        "SMARTHOME_Mqtt__Password": "public",
        "SMARTHOME_Mqtt__UseTls": "false",
        "SMARTHOME_WeatherApi__Endpoint": "https://api.tomorrow.io/v4/weather/realtime",
        "SMARTHOME_WeatherApi__ApiKey": "key",
        "SMARTHOME_WeatherApi__RefreshIntervalInMinutes": "5",
        "SMARTHOME_Diagnostics__TracingEnabled": "true",
        "SMARTHOME_Diagnostics__OtlpEndpoint": "http://localhost:4317"
      },
      "applicationUrl": "https://localhost:29983;http://localhost:29984"
    },
    "Container (Dockerfile)": {
      "commandName": "Docker",
      "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}",
      "environmentVariables": {
        "ASPNETCORE_HTTPS_PORTS": "8081",
        "ASPNETCORE_HTTP_PORTS": "8080",
        "SMARTHOME_Api__LogLevel": "3",
        "SMARTHOME_Api__Key": "secret",
        "SMARTHOME_MongoDb__ConnectionString": "mongodb://localhost:27017",
        "SMARTHOME_Mqtt__Host": "localhost",
        "SMARTHOME_Mqtt__Port": "1883",
        "SMARTHOME_Mqtt__Username": "admin",
        "SMARTHOME_Mqtt__Password": "public",
        "SMARTHOME_Mqtt__UseTls": "false",
        "SMARTHOME_WeatherApi__Endpoint": "https://api.tomorrow.io/v4/weather/realtime",
        "SMARTHOME_WeatherApi__ApiKey": "key",
        "SMARTHOME_WeatherApi__RefreshIntervalInMinutes": "5"
      },
      "publishAllPorts": true,
      "useSSL": true
    }
  }
}